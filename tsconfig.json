{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@modules/*": ["src/modules/*"],
      "@screens/*": ["src/screens/*"],
      "@components/*": ["src/components/*"],
      "@config": ["src/config"]
    }
  }
}
