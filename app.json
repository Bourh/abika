{
  "expo": {
    "name": "Abika",
    "slug": "abika",
    "version": "1.0.0",
    "scheme": "abika",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.abika.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.abika.app"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
